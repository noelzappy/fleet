# GENERATED by `fleet github init` from fleet.yaml — do not hand-edit. Commit via a PR.
# Required check: every agent PR names its profile and, with cross_vendor_review, carries
# a review from a profile of a different vendor. Humans still approve and merge.
name: pr-contract
on:
  pull_request: { types: [opened, edited, synchronize, reopened] }
  pull_request_review: { types: [submitted, dismissed] }
permissions:
  contents: read
  pull-requests: read
jobs:
  pr-contract:
    runs-on: ubuntu-latest
    steps:
      - env:
          GH_TOKEN: ${{"{{"}} github.token {{"}}"}}
          PR: ${{"{{"}} github.event.pull_request.number {{"}}"}}
          REPO: ${{"{{"}} github.repository {{"}}"}}
          VENDORS: '{{ .VendorsJSON }}'
          CROSS_VENDOR: '{{ .Routing.CrossVendorReview }}'
        run: |
          set -euo pipefail
          body=$(gh pr view "$PR" -R "$REPO" --json body -q .body)
          grep -Eq 'Closes #[0-9]+' <<<"$body" || { echo "::error::PR body must contain 'Closes #<issue>'"; exit 1; }
          impl=$(grep -Eo '^Model: *[A-Za-z0-9_-]+' <<<"$body" | head -1 | awk '{print $2}' || true)
          [ -n "$impl" ] || { echo "::error::PR body must contain a 'Model: <profile>' line"; exit 1; }
          # Commits are the owner's: no attribution trailers from agents or tools.
          bad=$(gh api "repos/$REPO/pulls/$PR/commits" --paginate -q '.[].commit.message' | grep -iE '^(Co-authored-by|Signed-off-by):.*(agent|bot|claude|gemini|gpt|codex|opencode|multica|anthropic|google|openai)|generated with|claude-session' || true)
          [ -z "$bad" ] || { echo "::error::commits carry agent attribution; amend them: $bad"; exit 1; }
          implv=$(jq -r --arg p "$impl" '.[$p] // empty' <<<"$VENDORS")
          [ -n "$implv" ] || { echo "::error::unknown profile '$impl' in Model line"; exit 1; }
          ok=0
          while IFS= read -r line; do
            p=$(sed -E 's/^Reviewed-by: *([A-Za-z0-9_-]+).*/\1/' <<<"$line")
            v=$(jq -r --arg p "$p" '.[$p] // empty' <<<"$VENDORS")
            [ -n "$v" ] || continue
            if [ "$CROSS_VENDOR" != "true" ] || [ "$v" != "$implv" ]; then ok=1; fi
          done < <(gh api "repos/$REPO/pulls/$PR/reviews" --paginate -q '.[].body' | grep -E '^Reviewed-by:' || true)
          if [ "$ok" != 1 ]; then
            echo "::error::needs a review whose body ends with 'Reviewed-by: <profile> (<vendor>)' from a vendor other than $implv ($impl). fleet sync assigns one when the PR opens."
            exit 1
          fi
          echo "pr-contract ok: implementer $impl ($implv), cross-vendor review present"
