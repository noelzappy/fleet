# GENERATED by `fleet orchestrator init` from fleet.yaml — do not hand-edit.
# TODO(implementer): verify EVERY key against the installed AO version (`ao config-help`,
# schema/config.schema.json). This template is a best guess of the shape, not the schema.
project:
  name: {{ .Project.Name }}
  repo: {{ .Project.Repo }}
  baseBranch: {{ .Project.Branch }}
dispatch:
  labels:
    ready: {{ .Labels.Ready }}
    blockers: [{{ .Labels.NeedsHuman }}, {{ .Labels.NeedsResource }}, {{ .Labels.NeedsContract }}, {{ .Labels.BlockedBy }}, {{ .Labels.Stuck }}]
    pauseIfOpenIssueLabelled: {{ .Labels.Paused }}
  priority:
{{- range .Waves }}
    - wave:{{ .Name }}
{{- end }}
gate:
  command: "{{ .Gate.Command }}"
  timeout: {{ .Gate.Timeout }}
  maxAttempts: {{ .Routing.MaxGateAttempts }}
agents:
{{- range $name, $p := .Profiles }}
  {{ $name }}:
    harness: {{ (index $.Harnesses $p.Harness).Kind }}
    model: {{ $p.Model }}
    role: {{ $p.Role }}
    vendor: {{ $p.Vendor }}
    concurrency: {{ $p.Concurrency }}
    waves: [{{ range $i, $w := $p.Waves }}{{ if $i }}, {{ end }}{{ $w }}{{ end }}]
{{- end }}
review:
  crossVendor: {{ .Routing.CrossVendorReview }}
